<div class="min-h-[80vh] w-full grid grid-cols-1 md:grid-cols-2">
  
  <!-- Left Side -->
  <div class="bg-indigo-600 text-white flex flex-col justify-center items-center p-12">
    <h1 class="text-5xl font-extrabold mb-6">Educative</h1>
    <p class="text-lg text-indigo-100 max-w-md text-center">
      Learn faster, build better.  
      Sign up or log in to access our catalog of programming courses and resources.
    </p>
  </div>

  <!-- Right Side -->
  <div class="flex items-center justify-center p-8 bg-gray-50">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl shadow-lg">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6 text-center">
        Sign up for free
      </h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), class: "space-y-6") do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
                class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700" %>
          <% if @minimum_password_length %>
            <em class="text-xs text-gray-500">(<%= @minimum_password_length %> characters minimum)</em>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password",
                class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
                class: "mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div class="mb-6">
        <h3 class="text-lg font-semibold text-gray-800 text-center mb-4">Select Your Role</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <% [
            ["Student", :student, "Learn faster with structured content", "student-person-svgrepo-com.svg"],
            ["Instructor", :instructor, "Create and share your knowledge", "teacher-svgrepo-com.svg"]
          ].each do |label, value, desc, icon_file| %>

            <label class="relative cursor-pointer">
              <%= f.radio_button :role, value, class: "sr-only peer" %>

              <div class="p-6 rounded-2xl border border-gray-300 bg-white shadow-sm peer-checked:border-indigo-600 peer-checked:ring-2 peer-checked:ring-indigo-500 transition hover:shadow-lg hover:-translate-y-1 flex flex-col items-center text-center">

                <!-- Custom Icon -->
                <div class="w-16 h-16 mb-3 flex items-center justify-center rounded-full bg-indigo-50">
                  <%= image_tag(icon_file, alt: "#{label} icon", class: "w-10 h-10") %>
                </div>

                <!-- Title -->
                <span class="text-xl font-bold text-gray-900"><%= label %></span>
                <!-- Description -->
                <span class="mt-1 text-sm text-gray-500"><%= desc %></span>

                <!-- Checkmark when selected -->
                <div class="absolute top-3 right-3 hidden peer-checked:block text-indigo-600">
                  <i class="fas fa-check-circle text-xl"></i>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>

        <div>
          <%= f.submit "Sign up", class: "w-full flex justify-center mt-2 py-2 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none" %>
        </div>
      <% end %>

      <div class="mt-6 text-center text-sm text-gray-600">
        Already have an account?
        <%= link_to "Log in", new_session_path(resource_name), class: "text-indigo-600 hover:text-indigo-700 font-medium" %>
      </div>
    </div>
  </div>
</div>
